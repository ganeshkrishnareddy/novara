# NOVARA configuration template (copy to .env, then fill in what you need)
# Every variable below is OPTIONAL for a default local install. Do not commit
# the filled-in .env file; only this example is tracked by Git.

# --- Database -----------------------------------------------------------------
# Default (leave unset): SQLite at <PROJECT_ROOT>/novara_dev.sqlite3, resolved
# relative to the installed package so the working directory does not matter.
# NOVARA_DB_PATH=/absolute/path/to/novara_dev.sqlite3

# Optional PostgreSQL. Requires: pip install 'psycopg[binary]>=3.1'
# Run `alembic -c apps/api/alembic.ini upgrade head` before starting the app.
# NOVARA_DATABASE_URL=postgresql+psycopg://user:password@host:5432/novara

# --- Frontend / CORS -----------------------------------------------------------
# Comma-separated exact origins allowed to call the API cross-origin.
# Leave unset for same-origin only (the default and the recommended local mode).
# Example: NOVARA_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# NOVARA_CORS_ORIGINS=

# --- Security -----------------------------------------------------------------
# Authentication attempts allowed per client per sliding window (default 10).
# NOVARA_AUTH_RATE_LIMIT=10

# HMAC key for presigned document upload/download links. Set a unique value for
# every deployed instance; unset means an unpredictable per-process key, except
# in explicit NOVARA_DEV_MODE where the legacy development value is retained.
# NOVARA_PRESIGN_SECRET=

# Developer conveniences used only by the local seed/setup endpoints.
# NEVER enable this in a deployed instance.
# NOVARA_DEV_MODE=

# --- Local performance probe --------------------------------------------------
# The probe in scripts/performance_probe.py uses these only for its login call.
# They are NOT application settings and are never read by the running server.
# NOVARA_PERF_EMAIL=qa.owner@example.com
# NOVARA_PERF_PASSWORD=Password123!

# --- Outbound providers -------------------------------------------------------
# None. NOVARA adapters are local mocks in this build. There are no provider
# credentials, API keys, webhooks or outbound endpoints to configure. Any
# future real integration must be added deliberately with its own documented
# secret handling; do not paste provider keys into this file.
